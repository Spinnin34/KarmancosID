# Conexión MongoDB. Define esta variable solo en .env local o en el entorno del servidor. 
MONGODB_URI=
MONGODB_DATABASE=karmancosid
MONGODB_CREATE_INDEXES=true

# Set a strong, unique value before starting the stack.
KARMANCOS_BOOTSTRAP_ADMIN_EMAIL=
KARMANCOS_BOOTSTRAP_ADMIN_PASSWORD=

# Local development defaults. Production needs externally managed RSA key files, SMTP,
# a stable random HMAC secret (>=32 characters), HTTPS and secure cookies.
KARMANCOS_ISSUER=http://localhost
CADDY_SITE=http://localhost
KARMANCOS_SECURE_COOKIES=false
KARMANCOS_SESSION_COOKIE_NAME=KARMANCOSID
SPRING_PROFILES_ACTIVE=local
KARMANCOS_SUBJECT_HMAC_SECRET=
KARMANCOS_PRIVATE_KEY_PATH=
KARMANCOS_PUBLIC_KEY_PATH=

# Vercel containers: alternative to key paths; use one-line base64 PEM values.
KARMANCOS_PRIVATE_KEY_PEM_B64=
KARMANCOS_PUBLIC_KEY_PEM_B64=
PORT=8080

# Configure an SMTP-compatible mail service for verification and account recovery.
KARMANCOS_PUBLIC_BASE_URL=http://localhost
KARMANCOS_MAIL_FROM=no-reply@karmancos.com
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
