---
import Layout from "../../layouts/Layout.astro";
import { ShieldCheck, ArrowUpRight, Fingerprint } from "@lucide/vue";
import Card from "../ui/Card.vue";

interface Props {
  title: string;
  layout?: "brand-split" | "focused";
}

const { title, layout = "brand-split" } = Astro.props;
---

<Layout title={title}>
  <main class:list={["auth-shell", `auth-shell--${layout}`]}>
    <section class="auth-story" aria-labelledby="story-title">
      <header class="story-topline">
        <a class="brand-lockup" href="/" aria-label="Karmancos ID, inicio">
          <span class="brand-mark" aria-hidden="true"><img src="/images/karmancos-id-mark.png" alt="" /></span>
          <span class="brand-name">KARMANCOS<span>ID</span></span>
        </a>
      </header>

      <div class="story-main">
        <div class="story-copy">
          <h1 id="story-title">Una cuenta.<br />Todo Karmancos.</h1>
          <p class="story-description">Inicia sesión en los servicios Karmancos con una sola cuenta. Cada sitio te pedirá permiso antes de acceder a tus datos.</p>
        </div>
        <div class="identity-pass-stage" aria-label="Una identidad para tus servicios">
          <Card variant="surface" shadow="none" class="identity-pass">
            <div class="identity-pass-top"><span>KARMANCOS ID</span><ArrowUpRight size={20} strokeWidth={1.6} /></div>
            <div class="identity-pass-mark"><img src="/images/karmancos-id-mark.png" alt="" /><Fingerprint size={92} strokeWidth={.8} aria-hidden="true" /></div>
            <div class="identity-pass-bottom"><span>Tu identidad.<br /><strong>Siempre contigo.</strong></span><ShieldCheck size={26} strokeWidth={1.3} /></div>
          </Card>
          <div class="identity-pass-caption"><span class="identity-signal" aria-hidden="true"></span>Tu cuenta <span aria-hidden="true">—</span> Tus servicios</div>
        </div>
      </div>
      <footer class="auth-story-note"><ShieldCheck size={16} strokeWidth={1.5} /> Tú decides qué datos compartes.</footer>
    </section>

    <section class="auth-panel" aria-label="Cuenta de Karmancos ID" data-ui="identity-auth">
      <div class="auth-panel-inner">
        <a class="brand-lockup auth-focused-brand" href="/" aria-label="Karmancos ID, inicio">
          <span class="brand-mark" aria-hidden="true"><img src="/images/karmancos-id-mark.png" alt="" /></span>
          <span class="brand-name">KARMANCOS<span>ID</span></span>
        </a>
        <div class="auth-flow">
          <slot />
          <div class="auth-trust-strip">
            <span class="trust-shield" aria-hidden="true"><ShieldCheck size={21} strokeWidth={1.8} /></span>
            <p><strong>Tu contraseña no se comparte.</strong><span>Los sitios conectados reciben solo los permisos que autorizas.</span></p>
          </div>
        </div>
      </div>
      <footer class="auth-panel-footer">
        <span>© {new Date().getFullYear()} Karmancos</span>
        <span class="auth-footer-links"><a href="/desarrolladores">Desarrolladores</a></span>
      </footer>
    </section>
  </main>
</Layout>
