---
import "../index.css";
import PreviewToolbar from "../components/preview/PreviewToolbar.vue";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Una cuenta Karmancos para todos tus proyectos." } = Astro.props;
---

<!doctype html>
<html lang="es" data-palette="my-design-system" data-theme="my-design-system" data-balsa-adapt data-preview-allowed={import.meta.env.DEV ? "true" : "false"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f1012" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/images/karmancos-id-mark.png" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (root.dataset.previewAllowed !== "true") return;
        const requested = new URLSearchParams(window.location.search).get("preview") === "1";
        try {
          if (requested) window.sessionStorage.setItem("karmancos-id-preview", "1");
          if (requested || window.sessionStorage.getItem("karmancos-id-preview") === "1") {
            root.dataset.previewActive = "true";
          }
        } catch {
          if (requested) root.dataset.previewActive = "true";
        }
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    {import.meta.env.DEV && <PreviewToolbar client:load />}
    <slot />
    <script>
      import { createDesignThemeStore } from "@/theme/theme-store";
      import { myDesignSystemTheme } from "@/themes/my-design-system";

      const themeStore = createDesignThemeStore({ themes: [myDesignSystemTheme] });
      themeStore.selectTheme(myDesignSystemTheme);
    </script>
  </body>
</html>
