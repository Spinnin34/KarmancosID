# Copia este archivo a web/.env para ejecutar la API Astro en local.
# Usa siempre una base de pruebas y claves distintas de las de producción.
MONGODB_URI=
MONGODB_DATABASE=karmancosid
MONGODB_CREATE_INDEXES=true

PUBLIC_IDENTITY_ISSUER=http://localhost:4321
KARMANCOS_ISSUER=http://localhost:4321
KARMANCOS_PUBLIC_BASE_URL=http://localhost:4321
KARMANCOS_SECURE_COOKIES=false
KARMANCOS_SESSION_COOKIE_NAME=KARMANCOSID
KARMANCOS_SUBJECT_HMAC_SECRET=

KARMANCOS_PRIVATE_KEY_PEM_B64=
KARMANCOS_PUBLIC_KEY_PEM_B64=

KARMANCOS_BOOTSTRAP_ADMIN_EMAIL=
KARMANCOS_BOOTSTRAP_ADMIN_PASSWORD=

SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
KARMANCOS_MAIL_FROM=no-reply@karmancos.com
